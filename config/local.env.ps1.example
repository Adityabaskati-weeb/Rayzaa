$env:RAZORPAY_KEY_ID = "rzp_test_replace_me"
$env:RAZORPAY_KEY_SECRET = "replace_me"
$env:RAZORPAY_WEBHOOK_SECRET = "replace_me"

$env:TELEGRAM_BOT_TOKEN = "123456789:replace_me"
$env:TELEGRAM_CHAT_ID = "replace_me"
# Optional if you use a Telegram forum topic / thread.
$env:TELEGRAM_MESSAGE_THREAD_ID = ""

# For demo mode, keep alerts at Watch or Fractured depending on the choreography you want.
$env:RAYZAA_TELEGRAM_MIN_TRUST_STATE = "Watch"

# Use a public HTTPS API URL here when testing live Razorpay webhooks.
# Example: https://rayzaa-api-demo.onrender.com
$env:RAYZAA_PUBLIC_API_URL = "https://replace-me.example.com"

# Use the frontend URL the presenter or judges will open.
# Local demo example: http://127.0.0.1:3000
$env:RAYZAA_PUBLIC_APP_URL = "http://127.0.0.1:3000"

# Backend CORS must allow the app URL.
$env:RAYZAA_CORS_ORIGIN = "http://127.0.0.1:3000"

# Optional deployment overrides.
# $env:NEXT_PUBLIC_API_BASE = "https://replace-me.example.com"
# $env:NEXT_PUBLIC_WS_URL = "wss://replace-me.example.com/ws/live"
